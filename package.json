{
  "name": "refden-extension",
  "version": "4.0.1",
  "main": "index.js",
  "author": "Mario Perez <mapreal19@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "webpack --watch --progress --mode=development",
    "lint": "eslint app",
    "test": "jest",
    "test:watch": "jest --watch",
    "compress": "webpack --mode=production && zip -r -X app.zip app/",
    "manifest:to-firefox": "cp app/manifest.firefox.json app/manifest.json",
    "manifest:to-chrome": "cp app/manifest.chrome.json app/manifest.json"
  },
  "dependencies": {
    "@vespaiach/axios-fetch-adapter": "^0.3.1",
    "autosize": "^4.0.2",
    "jquery": "^4.0.0",
    "lodash": "^4.18.1",
    "select2": "^4.1.0",
    "toastr": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.3",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.15.0",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^26.1.0",
    "regenerator-runtime": "^0.13.5",
    "style-loader": "^4.0.0",
    "web-ext": "^10.7.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.2.3",
    "webpack-notifier": "^1.17.0"
  },
  "resolutions": {
    "fx-runner@npm:1.6.0": "npm:1.7.0",
    "glob@npm:^10.4.1": "npm:14.0.6",
    "glob@npm:^13.0.0": "npm:14.0.6",
    "glob@npm:^13.0.6": "npm:14.0.6",
    "minimatch@npm:^10.2.2": "npm:11.0.9",
    "node-notifier@npm:^9.0.0": "npm:11.0.0"
  },
  "browserslist": "> 0.25%, not dead",
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./app/libs/tests/setup.js"
    ],
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.css$": "identity-obj-proxy"
    }
  },
  "packageManager": "yarn@4.19.0"
}
